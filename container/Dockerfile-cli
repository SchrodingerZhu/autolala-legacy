# CLI-only image: the `analyzer` binary plus Polygeist's `cgeist` for direct
# C input.
#
# Two toolchains, both from apt.llvm.org — nothing is compiled from LLVM
# source:
#   - Polygeist pins LLVM 16 (its llvm-project submodule), so its stage is
#     ubuntu 22.04 + apt LLVM 16 (apt.llvm.org does not build 16 for noble).
#   - The analyzer builds on ubuntu 24.04 + apt LLVM 22 (mlir-sys 220 /
#     melior 0.27).
# The final image is 24.04; the Polygeist stage's /usr/lib/llvm-16 runtime is
# copied over (jammy binaries run fine on noble's newer glibc).

# ---------------------------------------------------------------- polygeist
FROM ubuntu:22.04 AS polygeist
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg lsb-release software-properties-common \
    git cmake ninja-build build-essential python3 zlib1g-dev libzstd-dev
RUN curl -fsSL https://apt.llvm.org/llvm.sh -o /tmp/llvm.sh \
    && chmod +x /tmp/llvm.sh \
    && /tmp/llvm.sh 16 \
    && apt-get install -y --no-install-recommends \
       libmlir-16-dev mlir-16-tools clang-16 libclang-16-dev libpolly-16-dev
# Shallow clone; the llvm-project submodule is NOT initialized — we build
# against the apt LLVM 16 above instead of the pinned submodule.
RUN git clone --depth 1 https://github.com/llvm/Polygeist /opt/polygeist-src
RUN cmake -S /opt/polygeist-src -B /opt/polygeist-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DMLIR_DIR=/usr/lib/llvm-16/lib/cmake/mlir \
      -DClang_DIR=/usr/lib/llvm-16/lib/cmake/clang \
      -DLLVM_DIR=/usr/lib/llvm-16/lib/cmake/llvm \
      -DPOLYGEIST_USE_LINKER=lld-16 \
    && cmake --build /opt/polygeist-build --target cgeist polygeist-opt \
    && mkdir -p /opt/polygeist/bin \
    && cp /opt/polygeist-build/bin/cgeist /opt/polygeist-build/bin/polygeist-opt \
         /opt/polygeist/bin/

# ---------------------------------------------------------------- builder
FROM ubuntu:24.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg lsb-release software-properties-common \
    git build-essential cmake ninja-build pkg-config \
    autoconf automake libtool \
    libgmp-dev libmpfr-dev libmpc-dev libntl-dev \
    libzstd-dev zlib1g-dev \
    libfreetype-dev libfontconfig-dev \
    python3
RUN curl -fsSL https://apt.llvm.org/llvm.sh -o /tmp/llvm.sh \
    && chmod +x /tmp/llvm.sh \
    && /tmp/llvm.sh 22 \
    && apt-get install -y --no-install-recommends \
       libmlir-22-dev mlir-22-tools libpolly-22-dev libclang-22-dev lld-22 lld
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain none
ENV PATH=/root/.cargo/bin:$PATH
# mlir-sys/tblgen (220), melior-macro still reads the LLVM-21-era variable
# while targeting 22, and llvm-sys consumers use 220/221 — set all of them.
ENV MLIR_SYS_220_PREFIX=/usr/lib/llvm-22 \
    TABLEGEN_220_PREFIX=/usr/lib/llvm-22 \
    MLIR_SYS_210_PREFIX=/usr/lib/llvm-22 \
    LLVM_SYS_220_PREFIX=/usr/lib/llvm-22 \
    LLVM_SYS_221_PREFIX=/usr/lib/llvm-22 \
    LIBCLANG_PATH=/usr/lib/llvm-22/lib
WORKDIR /src
COPY . .
# rust-toolchain at the repo root pins the nightly; rustup picks it up.
RUN cargo build --release -p analyzer

# ---------------------------------------------------------------- runtime
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgmp10 libmpfr6 libmpc3 libntl44 libzstd1 zlib1g \
    libfreetype6 libfontconfig1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Polygeist runtime: cgeist/polygeist-opt link the shared LLVM 16 libraries.
COPY --from=polygeist /usr/lib/llvm-16 /usr/lib/llvm-16
COPY --from=polygeist /opt/polygeist/bin/cgeist /opt/polygeist/bin/polygeist-opt /usr/local/bin/
COPY --from=builder /src/target/release/analyzer /usr/local/bin/analyzer
ENTRYPOINT ["/usr/local/bin/analyzer"]
